// The clouds' noise and weather. The tiling volumes they are carved from follow Schneider, "The Real-time Volumetric
// Cloudscapes of Horizon Zero Dawn" (2015): Perlin-Worley billows for their shape, and Worley octaves for the detail that
// erodes their edges. The weather is a June climatology over the survey's land and sea, redrawn as it drifts and churns.
#pragma kernel Shape
#pragma kernel Detail
#pragma kernel Bound
#pragma kernel Histogram
#pragma kernel Weather

#define PI 3.14159265

RWTexture3D<float> _Volume;
RWTexture3D<float> _Bound;
Texture3D<float> _Source;
uint _Size;
uint _Scale;

// Land share and ground height (over LAND_HEIGHT_RANGE km) per cell, laid out as the weather is.
Texture2D<float2> _Land;
SamplerState sampler_linear_repeatU_clampV;

// Per cell: low cloud's cover, base (over WEATHER_BASE_RANGE km) and top (over WEATHER_TOP_RANGE km), and the anvils'
// cover. Equirectangular, row 0 at the north pole and column 0 at 180 W.
RWTexture2D<float4> _Weather;
float4 _WeatherSize;

// Per cell, laid out as the weather is: an offset through the noise (over -1 to 1 of CLOUD_WARP in Clouds.hlsl) and the
// finer heap tiling's share of the heaps, so some regions raise bigger heaps than others. Neither repeats round the planet.
RWTexture2D<float4> _Warp;

// How far east the weather has drifted (radians), its offset through the noise as it churns, its cyclones' stage of life
// (0 to 1 over a cycle), and the sun in the body's frame.
float _WeatherDrift;
float3 _WeatherChurn;
float _WeatherPhase;
float3 _WeatherSun;

// Match CloudView.LandHeightRange, and CLOUD_BASE_RANGE and CLOUD_TOP in Clouds.hlsl.
#define LAND_HEIGHT_RANGE 2.0
#define WEATHER_BASE_RANGE 8.0
#define WEATHER_TOP_RANGE 16.0

// Storm cells across the tile (about 40 km apart), and the cyclones round each hemisphere.
#define STORM_CELLS 64
#define CYCLONES 8

// PCG's 3D hash (Jarzynski and Olano, 2020); Unity's math.hash is linear, which lines features up.
uint3 Pcg3(uint3 v) {

    v = v * 1664525u + 1013904223u;
    v.x += v.y * v.z;
    v.y += v.z * v.x;
    v.z += v.x * v.y;
    v ^= v >> 16u;
    v.x += v.y * v.z;
    v.y += v.z * v.x;
    v.z += v.x * v.y;

    return v;

}

float3 Random3(int3 cell, int period, uint seed) {

    // Cells reach at most one tile below zero, so one period lifts them clear for an unsigned wrap.
    uint3 wrapped = uint3(cell + period) % uint(period);

    return (Pcg3(wrapped + seed * uint3(7919u, 104729u, 1299709u)) & 0xFFFFFFu) / 16777216.0;

}

// Distance to the nearest of one feature point per cell, over period cells to the tile.
float Worley(float3 p, int period, uint seed) {

    float3 scaled = p * period;
    int3 cell = int3(floor(scaled));
    float3 f = scaled - cell;
    float nearest = 1.0;

    for (int i = 0; i < 27; i++) {

        int3 offset = int3(i % 3, (i / 3) % 3, i / 9) - 1;

        nearest = min(nearest, length(offset + Random3(cell + offset, period, seed) - f));

    }

    return nearest;

}

// Gradient noise, zero at the lattice and roughly within -1 to 1, over period cells to the tile.
float Perlin(float3 p, int period, uint seed) {

    float3 scaled = p * period;
    int3 cell = int3(floor(scaled));
    float3 f = scaled - cell;
    float3 fade = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
    float corners[8];

    for (int i = 0; i < 8; i++) {

        int3 offset = int3(i & 1, (i >> 1) & 1, i >> 2);
        float3 gradient = normalize(Random3(cell + offset, period, seed) * 2.0 - 1.0 + 1e-4);

        corners[i] = dot(gradient, f - offset);

    }

    float4 x = lerp(float4(corners[0], corners[2], corners[4], corners[6]), float4(corners[1], corners[3], corners[5], corners[7]), fade.x);
    float2 y = lerp(x.xz, x.yw, fade.y);

    return lerp(y.x, y.y, fade.z) * 1.6;

}

// Perlin octaves from period cells to the tile, roughly within -1 to 1.
float Fbm(float3 p, int period, int octaves, uint seed) {

    float sum = 0.0;
    float amplitude = 0.5;

    for (int i = 0; i < octaves; i++) {

        sum += amplitude * Perlin(p, period << i, seed + i);
        amplitude *= 0.5;

    }

    return sum;

}

float Remap(float value, float from, float to, float newFrom, float newTo) {

    return newFrom + (value - from) / (to - from) * (newTo - newFrom);

}

// Billows: Perlin octaves, dilated by the Worley cells so they gather into rounded heaps, then carved by finer cells.
[numthreads(4, 4, 4)]
void Shape(uint3 id : SV_DispatchThreadID) {

    float3 p = (id + 0.5) / _Size;
    float perlin = saturate(Fbm(p, 4, 4, 0u) / 0.9375 * 0.5 + 0.5);
    float cells = 0.625 * (1.0 - Worley(p, 4, 11u)) + 0.25 * (1.0 - Worley(p, 8, 12u)) + 0.125 * (1.0 - Worley(p, 16, 13u));
    float fine = 0.625 * (1.0 - Worley(p, 8, 14u)) + 0.25 * (1.0 - Worley(p, 16, 15u)) + 0.125 * (1.0 - Worley(p, 32, 16u));
    float billows = Remap(perlin, cells - 1.0, 1.0, 0.0, 1.0);

    // The octaves stack into about 0.68 to 0.87; stretched over the whole range, cover can carve heaps from them.
    _Volume[id] = saturate((Remap(billows, fine - 1.0, 1.0, 0.0, 1.0) - 0.68) / 0.19);

}

// Billows some 275 m across over CLOUD_DETAIL_SIZE in Clouds.hlsl, and finer; with fewer cells a side, the tile's handful
// of billows would repeat in rows.
[numthreads(4, 4, 4)]
void Detail(uint3 id : SV_DispatchThreadID) {

    float3 p = (id + 0.5) / _Size;
    float cells = 0.625 * (1.0 - Worley(p, 4, 21u)) + 0.25 * (1.0 - Worley(p, 8, 22u)) + 0.125 * (1.0 - Worley(p, 16, 23u));

    // Likewise from about 0.12 to 0.67.
    _Volume[id] = saturate((cells - 0.12) / 0.55);

}

// The shape's bounds, a level at a time: each cell's highest value within one cell's width of it. The finest level reads
// the shape's texels round each (_Scale 1); each coarser one reads the four cells a side of the level below that span the
// same reach (_Scale 2), as they already bound their own neighbours. The tile wraps.
[numthreads(4, 4, 4)]
void Bound(uint3 id : SV_DispatchThreadID) {

    if (any(id >= _Size)) {

        return;

    }

    int span = _Scale + 2;
    int size = _Size * _Scale;
    int3 first = int3(id * _Scale) - 1 + size;
    float highest = 0.0;

    for (int i = 0; i < span * span * span; i++) {

        int3 at = first + int3(i % span, (i / span) % span, i / (span * span));

        highest = max(highest, _Source.Load(int4(at % size, 0)));

    }

    _Volume[id] = highest;
    _Bound[id] = highest;

}

// Counts the shape's values in 256 bins per mip, so blurred mips can be ranked back onto the sharp one's values.
RWStructuredBuffer<uint> _Histogram;
uint _Mip;

[numthreads(4, 4, 4)]
void Histogram(uint3 id : SV_DispatchThreadID) {

    if (any(id >= _Size)) {

        return;

    }

    InterlockedAdd(_Histogram[_Mip * 256u + (uint)round(saturate(_Source.Load(int4(id, _Mip))) * 255.0)], 1u);

}

float Band(float x, float centre, float width) {

    return exp(-(x - centre) * (x - centre) / (width * width));

}

// Height (km) of the tropopause, where storm towers stop and spread into anvils; matches Tropopause in Clouds.hlsl.
float Tropopause(float sinLatitude) {

    return lerp(15.0, 11.0, smoothstep(0.35, 0.7, abs(sinLatitude)));

}

float LandAt(float2 uv) {

    return _Land.SampleLevel(sampler_linear_repeatU_clampV, uv, 0.0).x;

}

// Thunderstorms, one to a cell of a jittered lattice where the potential beats the cell's own draw: the tallest tower
// (a dome over its core, 0 to 1) and the anvil spreading a cell's width round it.
float2 Storms(float3 p, float potential) {

    float3 scaled = p * STORM_CELLS;
    int3 cell = int3(floor(scaled));
    float3 f = scaled - cell;
    float2 storm = 0.0;

    for (int i = 0; i < 27; i++) {

        int3 offset = int3(i % 3, (i / 3) % 3, i / 9) - 1;
        float reach = length(offset + Random3(cell + offset, STORM_CELLS, 31u) - f);
        float strength = saturate((0.5 * potential - Random3(cell + offset, STORM_CELLS, 32u).x) * 8.0);

        storm = max(storm, strength * float2(sqrt(saturate(1.0 - reach * reach / 0.16)), saturate(1.0 - reach)));

    }

    return storm;

}

// The comma clouds of the storm tracks' cyclones, spaced round each hemisphere in the drifting frame, each with its own
// latitude, size and stage of life: a band that trails equatorward as the cold front and winds cyclonically (mirrored
// south of the equator) into a head over the low. Latitude in degrees, longitude in radians; warp bends the bands and
// breakup, finer, frays them and breaks them into lengths.
float Fronts(float latitude, float longitude, float warp, float breakup) {

    int hemisphere = latitude >= 0.0 ? 1 : -1;
    float spacing = 2.0 * PI / CYCLONES;
    int nearest = (int)floor(longitude / spacing);
    float front = 0.0;

    for (int k = -1; k <= 1; k++) {

        int index = nearest + k;
        float3 random = Random3(int3(index, hemisphere, 0), CYCLONES, 41u);
        float3 more = Random3(int3(index, hemisphere, 1), CYCLONES, 41u);
        float centre = hemisphere * (44.0 + 14.0 * random.y);
        float size = 6.0 + 4.0 * random.z;
        float east = (longitude - (index + 0.25 + 0.5 * random.x) * spacing) * (180.0 / PI) * cos(radians(centre));
        float2 offset = float2(east, (latitude - centre) * hemisphere) / size;
        float r = length(offset);

        // A logarithmic spiral: north-west of the low at half its size, swinging south as it reaches out, but less than a
        // turn, so it trails off as a tail instead of closing into a ring.
        float arm = 2.6 - 1.5 * log(max(r, 0.05) / 0.5);
        float delta = atan2(offset.y, offset.x) + 1.2 * warp + 0.8 * breakup - arm;
        float width = lerp(0.6, 0.25, saturate((r - 0.5) / 2.5)) * (1.0 + 0.6 * breakup);

        delta -= 2.0 * PI * round(delta / (2.0 * PI));

        float band = exp(-(delta * r / width) * (delta * r / width)) * saturate((3.0 - r) / 1.2) * saturate(0.6 + 1.2 * breakup);
        float life = smoothstep(0.0, 0.5, sin(2.0 * PI * (_WeatherPhase + more.x)));

        // June: the southern track, in its winter, is the stronger.
        front = max(front, (hemisphere > 0 ? 0.7 : 1.0) * life * max(band, 0.8 * saturate(1.0 - r / 0.4)));

    }

    return front;

}

// How heaps gather, 0 to 1 about a mean of a half: cloud systems at every size from some 20 to 160 km, as real fields are,
// their outlines dragged about by a coarser flow (displaced up to about 100 km) so they swirl and trail instead of sitting
// on a lattice.
float Organization(float3 p) {

    float3 flow = float3(Fbm(p, 8, 2, 81u), Fbm(p, 8, 2, 83u), Fbm(p, 8, 2, 85u));

    return saturate(0.5 + 1.8 * Fbm(p + 0.04 * flow, 16, 4, 71u));

}

// A kind of heap's regional cover gathered by the organisation: thinned between systems and whole in their cores.
float Gather(float regional, float organized, float core) {

    return max(saturate(regional * (0.2 + 1.2 * organized)), core);

}

// Each kind of cloud claims the cell by its cover; heights blend by the claims, so kinds meet without steps.
void Claim(inout float4 claims, float cover, float base, float top) {

    float claim = pow(cover, 4.0) + 1e-6;

    claims += float4(claim * base, claim * top, claim, 0.0);
    claims.w = max(claims.w, cover);

}

[numthreads(8, 8, 1)]
void Weather(uint3 id : SV_DispatchThreadID) {

    float2 uv = (id.xy + 0.5) * _WeatherSize.zw;
    float latitude = PI * (0.5 - uv.y);
    float longitude = PI * (2.0 * uv.x - 1.0);
    float lat = latitude * (180.0 / PI);
    float2 ground = _Land.SampleLevel(sampler_linear_repeatU_clampV, uv, 0.0);
    float land = ground.x;
    float height = ground.y * LAND_HEIGHT_RANGE;
    float3 up = float3(cos(latitude) * cos(longitude), sin(latitude), cos(latitude) * sin(longitude));
    float day = smoothstep(0.0, 0.5, dot(up, _WeatherSun));

    // The weather's own pattern drifts east, as the shape noise does; land and sea hold still under it.
    float drifted = longitude - _WeatherDrift;

    drifted -= 2.0 * PI * round(drifted / (2.0 * PI));

    float3 p = float3(cos(latitude) * cos(drifted), sin(latitude), cos(latitude) * sin(drifted)) * 0.5 + 0.5;
    float synoptic = Fbm(p + _WeatherChurn, 6, 4, 1u);
    float meso = Fbm(p + 3.0 * _WeatherChurn, 48, 3, 5u);

    // June: the ITCZ north of the equator, drawn farther north over land by the monsoon, subsiding air under the
    // subtropical highs, the storm tracks, and afternoon storms over summer land, most of all over high ground.
    float itcz = Band(lat, lerp(7.0, 15.0, land), 7.0);
    float highs = saturate(Band(lat, 30.0, 8.0) + Band(lat, -25.0, 9.0));
    float tracks = 0.7 * Band(lat, 52.0, 12.0) + Band(lat, -50.0, 12.0);
    float summer = land * day * Band(lat, 42.0, 12.0);
    float potential = saturate(itcz * (0.8 + 0.5 * synoptic) + summer * (0.35 + 0.5 * synoptic + 0.4 * height) - 0.6 * highs);

    // Marine stratocumulus over the cool water off the subtropical continents' west coasts: open ocean to the west, land
    // within some thirty degrees to the east.
    float east = 0.0;
    float west = 0.0;

    for (int k = 1; k <= 6; k++) {

        east = max(east, LandAt(uv + float2(k * 5.0 / 360.0, 0.0)) * (1.0 - k / 7.0));
        west = max(west, k <= 4 ? LandAt(uv - float2(k * 5.0 / 360.0, 0.0)) : 0.0);

    }

    float deck = saturate(1.5 * east * (1.0 - west) * (1.0 - land) * (Band(lat, 27.0, 10.0) + Band(lat, -18.0, 12.0)));

    // Cumulus: fair-weather heaps over land by day and trade cumulus at sea, sparse under the highs (and gone over the
    // deserts), swelling toward congestus where the air is unstable.
    float calm = saturate(1.0 - highs * lerp(0.6, 1.4, land));
    float cumulus = saturate((0.3 + 0.3 * potential + 0.15 * meso) * lerp(1.0, 0.2 + 0.8 * day, land) * calm);
    float cumulusBase = lerp(0.7, 1.4, land);
    float stratocumulus = saturate(smoothstep(55.0, 70.0, abs(lat)) + 0.6 * tracks) * saturate(0.6 + 0.6 * synoptic);

    // Cloud systems: where the organisation peaks, the region's heaps close up into unbroken masses at full cover; between
    // systems they thin to scattered heaps. A system is whole or absent: drier regions raise fewer and smaller ones, as
    // only the organisation's higher peaks clear their bar, and the driest none.
    float organized = Organization(p + _WeatherChurn);
    float bar = lerp(1.1, 0.55, saturate(max(cumulus, stratocumulus) / 0.4));
    float core = smoothstep(bar, bar + 0.1, organized);

    cumulus = Gather(cumulus, organized, core);
    stratocumulus = Gather(stratocumulus, organized, core);
    float front = Fronts(lat, drifted, synoptic, meso);
    float2 storm = Storms(p + 2.0 * _WeatherChurn, potential);
    float4 claims = 0.0;

    Claim(claims, cumulus, cumulusBase, cumulusBase + 1.0 + 3.0 * potential);
    Claim(claims, 0.92 * deck, 0.4, 1.1 + 0.6 * (1.0 - east));
    Claim(claims, stratocumulus, 0.4, 1.4);
    Claim(claims, front, 0.6, 2.5 + 3.0 * front);
    Claim(claims, saturate(3.0 * storm.x) * (0.6 + 0.35 * storm.x), 1.0, lerp(4.0, Tropopause(sin(latitude)) - height, storm.x));

    float base = height + claims.x / claims.z;
    float top = height + claims.y / claims.z;

    // The finer weather varies cover between systems but leaves their cores whole.
    float cover = saturate(claims.w * lerp(0.85 + 0.3 * meso, 1.0, core));

    _Weather[id.xy] = float4(cover, base / WEATHER_BASE_RANGE, top / WEATHER_TOP_RANGE, storm.y);

    // Two octaves (about 50 and 25 km) sit well above the grid's 8 km, so the bilinear lookup bends the tiles smoothly.
    float4 warp = float4(Fbm(p + _WeatherChurn, 48, 2, 61u), Fbm(p + _WeatherChurn, 48, 2, 63u), Fbm(p + _WeatherChurn, 48, 2, 65u),
        Fbm(p + _WeatherChurn, 24, 2, 67u)) / 0.75;

    _Warp[id.xy] = saturate(warp * 0.5 + 0.5);

}

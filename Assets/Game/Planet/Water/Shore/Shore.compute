// A shore cascade's field from its water depths: seeds where the shoreline crosses between texels (placed at the depth's
// zero crossing, so the line is finer than the texels), a jump flood carrying each texel's nearest seed, and the
// resolve: signed distance to shore, the direction toward land and how far the field agrees on it, and the shallowest
// water upwave, which shelters the water behind a reef or a spit.
#pragma kernel Seed
#pragma kernel Flood
#pragma kernel Resolve

#define SIZE 512
#define NONE -1e6
#define UPWAVE_STEPS 16

Texture2DArray<float> _ShoreDepth;
RWTexture2DArray<float4> _ShoreField;
Texture2D<float2> _SeedsIn;
RWTexture2D<float2> _SeedsOut;

uint _Slice;
int _Step;

// Metres a texel spans; the direction waves come from, in the cascade's axes; how far upwave to look (m).
float _Texel;
float2 _Upwave;
float _UpwaveReach;

float Depth(int2 p) {

    return _ShoreDepth[uint3(clamp(p, 0, SIZE - 1), _Slice)];

}

bool Valid(float2 seed) {

    return seed.x > NONE * 0.5;

}

[numthreads(8, 8, 1)]
void Seed(uint3 id : SV_DispatchThreadID) {

    static const int2 Neighbours[4] = { int2(1, 0), int2(-1, 0), int2(0, 1), int2(0, -1) };

    float depth = Depth(id.xy);
    float2 seed = NONE;
    float best = 1e9;

    [unroll]
    for (int i = 0; i < 4; i++) {

        float other = Depth(int2(id.xy) + Neighbours[i]);

        if ((depth > 0.0) != (other > 0.0)) {

            float2 crossing = float2(id.xy) + Neighbours[i] * (depth / (depth - other));
            float distance = length(crossing - float2(id.xy));

            if (distance < best) {

                best = distance;
                seed = crossing;

            }

        }

    }

    _SeedsOut[id.xy] = seed;

}

[numthreads(8, 8, 1)]
void Flood(uint3 id : SV_DispatchThreadID) {

    float2 here = float2(id.xy);
    float2 best = _SeedsIn[id.xy];
    float nearest = Valid(best) ? length(best - here) : 1e9;

    [unroll]
    for (int y = -1; y <= 1; y++) {

        [unroll]
        for (int x = -1; x <= 1; x++) {

            int2 at = int2(id.xy) + int2(x, y) * _Step;

            if (any(at < 0) || any(at >= SIZE)) {

                continue;

            }

            float2 seed = _SeedsIn[at];
            float distance = length(seed - here);

            if (Valid(seed) && distance < nearest) {

                nearest = distance;
                best = seed;

            }

        }

    }

    _SeedsOut[id.xy] = best;

}

// The unit direction from a texel toward land, by its nearest seed.
float2 TowardLand(int2 p) {

    p = clamp(p, 0, SIZE - 1);

    float2 seed = _SeedsIn[p];
    float2 offset = seed - float2(p);
    float length2 = dot(offset, offset);

    if (!Valid(seed) || length2 < 1e-8) {

        return 0.0;

    }

    return offset * rsqrt(length2) * (Depth(p) > 0.0 ? 1.0 : -1.0);

}

[numthreads(8, 8, 1)]
void Resolve(uint3 id : SV_DispatchThreadID) {

    int2 p = int2(id.xy);
    float2 seed = _SeedsIn[id.xy];
    float depth = Depth(p);
    bool water = depth > 0.0;
    float distance = Valid(seed) ? length(seed - float2(p)) * _Texel : SIZE * _Texel;
    float2 toward = TowardLand(p);

    // Where neighbours find their shore in other directions (the middle of a bay, the tip of a spit), the field has
    // no one direction; how far it agrees is carried as the length of the direction.
    float agreement = min(min(dot(toward, TowardLand(p + int2(1, 0))), dot(toward, TowardLand(p + int2(-1, 0)))),
        min(dot(toward, TowardLand(p + int2(0, 1))), dot(toward, TowardLand(p + int2(0, -1)))));

    // The shallowest water between here and upwave.
    float shallowest = max(depth, 0.0);

    [unroll]
    for (int i = 1; i <= UPWAVE_STEPS; i++) {

        float2 at = float2(p) + _Upwave * (i * _UpwaveReach / UPWAVE_STEPS / _Texel);

        shallowest = min(shallowest, max(Depth(int2(round(at))), 0.0));

    }

    _ShoreField[uint3(id.xy, _Slice)] = float4(water ? -distance : distance, toward * saturate(agreement), shallowest);

}
